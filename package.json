{
  "name": "pi-studio",
  "version": "0.3.4",
  "piRuntimeVersion": "0.84.1",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Pi Studio"
  },
  "description": "Pi Studio - a cross-platform desktop client for the pi coding agent (models, harness, extensions, sessions).",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.json",
    "test:permission": "node scripts/test-permission-gate.mjs",
    "bundle": "node scripts/bundle-runtime.mjs",
    "finalize-runtime": "node scripts/finalize-runtime.mjs",
    "pack": "npm run bundle && npm run build && electron-builder --dir && npm run finalize-runtime",
    "dist": "npm run bundle && npm run build && electron-builder && npm run finalize-runtime",
    "test:remote": "node scripts/test-remote-protocol.mjs",
    "test:remote-signaling": "node scripts/test-remote-signaling.mjs",
    "signaling": "node signaling/server.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.10.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "qrcode": "^1.5.4",
    "skills": "^1.5.22",
    "ws": "^8.21.2",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  },
  "build": {
    "appId": "com.pi-studio.app",
    "productName": "Pi Studio",
    "publish": [
      {
        "provider": "github",
        "owner": "flowflic",
        "repo": "Pi-Studio",
        "releaseType": "release"
      }
    ],
    "icon": "resources/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/runtime-manifest.json",
        "to": "runtime-manifest.json"
      },
      {
        "from": "runtime-release",
        "to": "runtime-package"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "icon": "resources/icon.ico",
      "executableName": "Pi Studio",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Pi-Studio-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "packElevateHelper": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pi Studio"
    },
    "mac": {
      "icon": "resources/icon.icns",
      "target": [
        "dmg"
      ],
      "artifactName": "Pi-Studio-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "resources/icon.png",
      "target": [
        "AppImage"
      ],
      "artifactName": "Pi-Studio-${version}-${arch}.${ext}"
    }
  }
}
